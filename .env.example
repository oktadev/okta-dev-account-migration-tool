# Copy this file to .env and fill in your Okta credentials
# These environment variables will be used by docker-compose

# Your Okta CLI Client ID (optional)
OKTA_CLI_CLIENT_ID=your_client_id_here

# Your Okta organization URL (e.g., https://dev-123456.okta.com)
OKTA_CLI_ORGURL=https://your-org.okta.com

# Your Okta API token
OKTA_CLI_TOKEN=your_api_token_here